# =============================================================================
# Document RAG service
# =============================================================================

APP_NAME=hermes_security_agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9000
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json
TZ=UTC
PYTHONUNBUFFERED=1

# LLM (answers after retrieval)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1

# Document RAG + embeddings
RAG_ENABLED=true
RAG_DOCS_DIR=./data/docs
RAG_CHROMA_ROOT=./data/rag/chroma
RAG_EMBED_PROVIDER=remote
RAG_EMBED_URL=http://host.docker.internal:8090
# RAG_EMBED_BEARER_TOKEN=
RAG_EMBED_TIMEOUT=120
RAG_EMBED_MODEL=text-embedding-3-small
# RAG_EMBED_DIM=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_EMBED_BATCH_SIZE=32
RAG_AUTO_REINDEX_ON_MISMATCH=false
RAG_SYSTEM_PROMPT_PATH=prompts/rag_agent_system.md

CORS_ORIGINS=*
API_WORKERS=1
API_RELOAD=false
# API_BEARER_TOKEN=

HEALTHCHECK_URL=http://127.0.0.1:9000/health
HEALTHCHECK_TIMEOUT_SECONDS=5
